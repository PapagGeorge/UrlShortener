# Copy to .env (git-ignored) and fill in. NEVER commit the real file.
# Generate secrets with:  openssl rand -hex 16   (passwords, letters and digits only)
#                         openssl rand -base64 32 (OBFUSCATION_KEY)

# --- Database ---
POSTGRES_DB=urlshortener
POSTGRES_PASSWORD=change-me-superuser
WRITE_DB_PASSWORD=change-me-write
READ_DB_PASSWORD=change-me-read

# --- Code generation ---
# 32 random bytes, base64. NEVER rotate it once codes exist: it re-maps the whole code space. Back it up.
OBFUSCATION_KEY=change-me-base64-32-bytes

# --- Public address of the short links (no path), e.g. https://short.example or http://192.168.1.50:8080 ---
PUBLIC_BASE_URL=http://localhost:8080

# --- Exposure. Defaults keep everything on this machine only. Set GATEWAY_BIND to the LAN address (or 0.0.0.0) to publish it. ---
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
# Jaeger (16686) and Prometheus (9090) UIs have no authentication: keep them on localhost or a trusted network.
OBSERVABILITY_BIND=127.0.0.1

# The web UI (React). Same idea as the Gateway: localhost by default, set WEB_BIND to the LAN address (or 0.0.0.0) to publish it.
WEB_BIND=127.0.0.1
WEB_PORT=3000
