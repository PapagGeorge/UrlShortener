{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 30 creations per client IP per minute. Redirects are never limited.
  "RateLimit": { "PermitLimit": 30, "Window": "00:01:00" },

  // Empty on purpose: X-Forwarded-For is ignored and the socket address is the client.
  // Set these to the proxy in front of the Gateway (e.g. KnownProxies: ["10.0.0.5"] or KnownNetworks: ["172.16.0.0/12"]).
  "ForwardedHeaders": { "KnownProxies": [], "KnownNetworks": [] },

  "ReverseProxy": {
    "Routes": {
      // POST /urls -> Write Service, rate limited, body capped at 8 KB.
      "create": {
        "ClusterId": "write",
        "Order": 0,
        "RateLimiterPolicy": "create-url",
        "MaxRequestBodySize": 8192,
        "Match": { "Path": "/urls", "Methods": [ "POST" ] },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      // GET/HEAD /{code} -> Read Service. Only things shaped like a short code (7-30 of A-Za-z0-9_-) get through: anything else is a 404 here.
      "redirect": {
        "ClusterId": "read",
        "Order": 10,
        "Match": { "Path": "/{code:regex(^[A-Za-z0-9_-]{{7,30}}$)}", "Methods": [ "GET", "HEAD" ] },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      }
    },
    "Clusters": {
      "write": {
        "Destinations": { "write-service": { "Address": "http://write-service:8080/" } },
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "read": {
        "Destinations": { "read-service": { "Address": "http://read-service:8080/" } },
        "HttpRequest": { "ActivityTimeout": "00:00:05" },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      }
    }
  }
}
