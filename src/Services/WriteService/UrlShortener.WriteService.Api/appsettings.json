{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "MigrateOnStartup": true },
  "Cleanup": { "Interval": "00:10:00", "BatchSize": 1000 },
  "Counter": { "BatchSize": 1000 }
}
