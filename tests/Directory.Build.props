<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The dev machine runs no Docker: integration tests are excluded unless CI=true (GitHub Actions sets it).
         An explicit filter passed to dotnet test still overrides this. -->
    <VSTestTestCaseFilter Condition="'$(CI)' != 'true' And '$(VSTestTestCaseFilter)' == ''">Category!=Integration</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
